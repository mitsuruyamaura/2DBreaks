    jp: "\u6700\u5927\u7372\u5F97\u30DD\u30A4\u30F3\u30C8 :"
    en: 'MaxGetCount:'
  - key: maxNumberOfErases
    jp: "\u307E\u3068\u3081\u6D88\u3057\u6700\u9AD8\u6570/1\u56DE :"
